rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cartas e decks públicos: leitura aberta
    match /cards/{cardId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /decks/{deckId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Dados privados de usuário (coleção do usuário, decks customizados, notas)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /user_cards/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /user_decks/{deckId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
