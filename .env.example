# ==============================================================================
# POKÉDEX TCG MASTER - ENVIRONMENT CONFIGURATION
# Copy this file to '.env' and fill in your Firebase credentials.
# ==============================================================================

# Firebase Web App Config (From Firebase Console -> Project Settings -> Web App)
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere123456789
VITE_FIREBASE_AUTH_DOMAIN=your-pokedex-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-pokedex-project
VITE_FIREBASE_STORAGE_BUCKET=your-pokedex-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Allowed Google Sign-In Emails (Comma-separated list)
# Only authenticated users with emails listed below will have access to the Pokédex.
VITE_ALLOWED_EMAILS=your.email@gmail.com,trainer@pokemon.com

# Project Support Email (Used for Google OAuth Brand screen & Firebase Auth)
VITE_SUPPORT_EMAIL=your.email@gmail.com

# Custom Domains & Authorized Domains (Comma-separated list)
# e.g.: pokedex.yourdomain.com,yourdomain.com
VITE_AUTHORIZED_DOMAINS=yourdomain.com,pokedex.yourdomain.com

# Connect-RPC Cloud Functions Endpoint (HTTPS URL)
VITE_CONNECT_RPC_URL=https://southamerica-east1-your-pokedex-project.cloudfunctions.net/api
